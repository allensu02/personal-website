---
import SiteLayout from "../../layouts/SiteLayout.astro";
const pageTitle = "my in n out order | allen";
---

<SiteLayout title={pageTitle}>
	<article>
		<h1>my in n out order</h1>

		<p>double double with no tomatoes, raw chopped onion, grilled onion, chopped chilies, extra spread (sometimes)</p>

		<p>animal fries with raw chopped onion, extra grilled onion, chopped chilies, extra spread (sometimes)</p>

		<p>strawberry shake</p>
	</article>

	<a href="/random" class="back-link">back to random</a>
</SiteLayout>

<style>
	p {
		margin-bottom: 1rem;
		color: var(--text-color);
	}

	.back-link {
		display: inline-block;
		margin-top: 2rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.back-link:hover {
		color: var(--link-color);
		text-decoration: none;
	}
</style>
