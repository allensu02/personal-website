---
import SiteLayout from "../layouts/SiteLayout.astro";
const pageTitle = "writings | allen";
---

<SiteLayout title={pageTitle}>
	<h1>writings</h1>

	<!-- The typewriter effect container -->
	<div class="typewriter">
		<span class="typewriter-text">coming soon...</span>
	</div>
</SiteLayout>

<style>
	.typewriter {
		display: inline-block;
	}

	.typewriter-text {

		display: inline-block;
		overflow: hidden;
		white-space: nowrap;
		border-right: 2px solid var(--link-color);

		width: 0;

		animation:
			typing 2s steps(14) forwards,
			cursor 0.5s step-end infinite;
	}

	@keyframes typing {
		from { width: 0; }
		to { width: 14ch; }
	}

	@keyframes cursor {
		0%, 100% { border-color: var(--link-color); }
		50% { border-color: transparent; }
	}
</style>
