---
import SiteLayout from "../layouts/SiteLayout.astro";
const pageTitle = "random | allen";
---

<SiteLayout title={pageTitle}>
	<h1>random</h1>

	<ul class="post-list">
		<li>
			<p>dominating on elyrion in polytopia</p>
			<a class="screenshot" href="/random/polytopia-elyrion-high-score.png" target="_blank" rel="noopener noreferrer" aria-label="View the full-size Polytopia high-score screenshot">
				<img src="/random/polytopia-elyrion-high-score.png" width="1206" height="2622" alt="Polytopia Elyrion leaderboard showing AllenSu02 in first place with 156,624 points." decoding="async" />
			</a>
		</li>
		<li>
			website inspirations:
			<a href="https://ingarobotics.com/" target="_blank" rel="noopener noreferrer">https://ingarobotics.com/</a>
			for adjustable colors
		</li>
	</ul>
</SiteLayout>

<style>
	.post-list {
		padding-left: 1.25rem;
		margin: 0;
	}

	.post-list li {
		padding-left: 0.25rem;
	}

	.post-list p {
		margin: 0 0 1.25rem;
	}

	.post-list li + li { margin-top: 2rem; }

	.screenshot {
		display: block;
		width: min(100%, 320px);
	}

	.screenshot img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
