---
import SiteLayout from "../layouts/SiteLayout.astro";
const pageTitle = "about me | allen";
---

<SiteLayout title={pageTitle}>
	<h1>about me</h1>

	<p>
		hey! i'm allen.
	</p>

	<p>
		i just moved back to the Bay Area
		i spent my last year in Taiwan
		this website is new, i'll be making lots of updates!
	</p>

	<h2>currently</h2>
	<p>
		open to new opportunities - especially interested in BCIs, Applied AI, and biotech!
	</p>

</SiteLayout>

<style>
	h2 {
		font-size: 1.25rem;
		font-weight: 600;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	p {
		margin-bottom: 1rem;
	}

	ul {
		padding-left: 1.5rem;
		margin-bottom: 1rem;
	}

	li {
		margin-bottom: 0.5rem;
	}

	.back-link {
		margin-top: 3rem;
		color: var(--text-muted);
	}
</style>
