---
const colors = [
	{ key: 'bg', label: 'bg', name: 'Background', value: '#000000' },
	{ key: 'text', label: 'text', name: 'Text', value: '#ffffff' },
	{ key: 'link', label: 'link', name: 'Link', value: '#5eead4' },
];
---

<div id="color-editor" class="color-editor" hidden>
	<button id="color-toggle" type="button" aria-expanded="false" aria-controls="color-controls">colors</button>
	<section id="color-controls" aria-label="Page colors" hidden>
		{colors.map(({ key, label, name, value }) => (
			<div class="color-row">
				<label for={`color-${key}`}>{label}</label>
				<input id={`color-${key}`} type="color" data-picker={key} value={value} aria-label={`${name} color picker`} />
				<input type="text" data-hex={key} value={value} aria-label={`${name} hex color`} aria-describedby="color-error" maxlength="7" spellcheck="false" autocomplete="off" autocapitalize="off" />
			</div>
		))}
		<p id="color-error" role="status" hidden>Use a hex color, like #5EEAD4.</p>
		<label class="swap-row"><input id="color-swap" type="checkbox" /> swap bg/text</label>
		<button id="color-reset" type="button">reset</button>
	</section>
</div>

<style>
	.color-editor {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 10;
		color: var(--controls-text, #ffffff);
		font-size: 0.9375rem;
		line-height: 1.4;
	}
	button, input { font: inherit; color: inherit; }
	button, input[type='text'], input[type='color'] {
		border: 1px solid currentColor;
		border-radius: 0;
		background: var(--bg-color);
	}
	button { cursor: pointer; padding: 0.6rem 0.9rem; }
	button:hover { text-decoration: underline; }
	button:focus-visible, input:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
	#color-controls {
		position: absolute;
		right: 0;
		bottom: calc(100% + 0.75rem);
		width: min(290px, calc(100vw - 3rem));
		max-height: calc(100dvh - 7rem);
		overflow-y: auto;
		padding: 1.25rem;
		border: 1px solid currentColor;
		background: var(--bg-color);
	}
	.color-row { display: grid; grid-template-columns: 2.25rem 2.5rem minmax(0, 1fr); gap: 0.65rem; align-items: center; margin-bottom: 0.75rem; }
	input[type='color'] { display: block; width: 100%; height: 2.5rem; padding: 0.15rem; cursor: pointer; }
	input[type='text'] { min-width: 0; width: 100%; height: 2.5rem; padding: 0.35rem 0.45rem; }
	input[aria-invalid='true'] { outline: 2px dashed currentColor; outline-offset: 2px; }
	#color-error { font-size: 0.8rem; margin: 0 0 0.75rem; }
	.swap-row { display: flex; align-items: center; gap: 0.65rem; padding-top: 1rem; margin-top: 1rem; border-top: 1px dotted currentColor; cursor: pointer; }
	input[type='checkbox'] { width: 1rem; height: 1rem; margin: 0; accent-color: var(--controls-text); }
	#color-reset { width: 100%; margin-top: 1rem; }
	[hidden] { display: none !important; }
</style>
